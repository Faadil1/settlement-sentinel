{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "strict": false,
    "outDir": "dist-server",
    "rootDir": "src"
  },
  "include": ["src/server.ts", "src/pipeline.ts", "src/types.ts"]
}
